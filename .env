PORT=3000
DATABASE_URL="file:./dev.db"
JWT_SECRET="citaflow_super_secure_production_ready_jwt_secret_2026_x"
FRONTEND_URL="http://localhost:3000"
APP_NAME="CitaFlow"
NODE_ENV="development"

# ==========================================
# WHATSAPP INTEGRATION CONFIGURATION
# ==========================================
# Options: 'mock' (default for dev/testing), 'cloud_api' (Meta), 'twilio'
WHATSAPP_PROVIDER=mock

# 1. Meta WhatsApp Cloud API (Graph API)
# Get from Meta Developers Console: https://developers.facebook.com
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_VERIFY_TOKEN=citaflow_meta_verify_token_2026
META_WA_API_VERSION=v21.0

# 2. Twilio Programmable Messaging API (Optional alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
