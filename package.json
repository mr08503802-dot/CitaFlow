{
  "name": "citaflow",
  "version": "1.0.0",
  "description": "Micro-SaaS para gestión de citas y eliminación de no-shows en Barberías, Peluquerías y Estudios de Estética",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "node scripts/start-prod.js",
    "build": "node scripts/build.js",
    "render:build": "npm run build",
    "render:start": "npm run start:prod",
    "dev": "node --watch src/server.js",
    "test": "node tests/citaflow.test.js && node tests/whatsapp.test.js && node tests/payment_and_calendar.test.js && node tests/receipt_auth.test.js && node tests/http_receipt.test.js && node tests/realtime.test.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "node prisma/seed.js",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "saas",
    "booking",
    "appointments",
    "barbershop",
    "salon",
    "whatsapp",
    "reminders"
  ],
  "author": "CitaFlow Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "stripe": "^23.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
