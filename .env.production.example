# ========================================================
# CitaFlow Micro-SaaS — Production Environment Variables
# Para Render, Railway, Supabase o Neon con PostgreSQL
# ========================================================

# 1. Configuración del Servidor & Entorno
NODE_ENV=production
PORT=3000
APP_NAME="CitaFlow"

# Secreto criptográfico para firma de JWT y Tokens HMAC de recibos (Mínimo 32 caracteres aleatorios)
JWT_SECRET=genera_un_secreto_seguro_con_openssl_rand_hex_32

# URL pública de tu plataforma (ej: https://citaflow.onrender.com o https://citaflow.up.railway.app)
# NOTA: En Render y Railway, se auto-detecta si no se especifica.
FRONTEND_URL=https://citaflow.onrender.com

# 2. Base de Datos Relacional PostgreSQL en la Nube (3NF)
# Render, Railway, Supabase o Neon inyectan automáticamente este valor.
# Formato: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://citaflow_user:password@host:5432/citaflow?sslmode=require"

# Si es 'true', al iniciar puebla la base de datos con el negocio de demostración (Barbería Imperio)
SEED_ON_STARTUP=true

# 3. Pasarela de Pagos (Stripe / Mercado Pago)
# Opciones: 'mock' (simulador sin costo), 'stripe', 'mercadopago'
PAYMENT_PROVIDER=mock

# Configuración Stripe (Modo Live o Test)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Configuración Mercado Pago (Opcional)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# 4. Mensajería Automatizada WhatsApp & Recordatorios 24h
# Opciones: 'mock' (simulador con logs en dashboard), 'cloud_api' (Meta), 'twilio'
WHATSAPP_PROVIDER=mock

# 4.1 Meta WhatsApp Cloud API (Graph API Oficial)
# Obtenidos en Meta for Developers: https://developers.facebook.com
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_VERIFY_TOKEN=citaflow_meta_verify_token_2026
META_WA_API_VERSION=v21.0

# 4.2 Twilio WhatsApp API (Alternativa opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
