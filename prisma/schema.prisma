// This is your Prisma schema file for CitaFlow (Micro-SaaS)
// Designed in Third Normal Form (3NF)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Business {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  email         String        @unique
  password_hash String
  phone         String
  address       String?
  currency      String        @default("USD")
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  services      Service[]
  staff         Staff[]
  appointments  Appointment[]

  @@map("businesses")
}

model Service {
  id               String        @id @default(cuid())
  business_id      String
  name             String
  description      String?
  duration_minutes Int
  price            Float
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  business         Business      @relation(fields: [business_id], references: [id], onDelete: Cascade)
  appointments     Appointment[]

  @@map("services")
}

model Staff {
  id            String        @id @default(cuid())
  business_id   String
  name          String
  email         String?
  phone         String?
  avatar_url    String?
  schedule_json String        // Working hours by day of week (JSON string)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  business      Business      @relation(fields: [business_id], references: [id], onDelete: Cascade)
  appointments  Appointment[]

  @@map("staff")
}

model Appointment {
  id                 String    @id @default(cuid())
  business_id        String
  service_id         String
  staff_id           String
  client_name        String
  client_phone       String
  client_email       String
  start_time         DateTime
  end_time           DateTime
  status             String    @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  confirmation_token String    @unique
  reminder_sent_at   DateTime?
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  business           Business  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  service            Service   @relation(fields: [service_id], references: [id], onDelete: Restrict)
  staff              Staff     @relation(fields: [staff_id], references: [id], onDelete: Restrict)
  receipt            Receipt?

  @@index([business_id, start_time])
  @@index([staff_id, start_time])
  @@map("appointments")
}

model Receipt {
  id             String      @id @default(cuid())
  appointment_id String      @unique
  receipt_number String      @unique
  total_amount   Float
  payment_method String      @default("CASH") // CASH, TRANSFER, CARD
  status         String      @default("PAID") // PAID, PENDING, REFUNDED
  issued_at      DateTime    @default(now())

  appointment    Appointment @relation(fields: [appointment_id], references: [id], onDelete: Cascade)

  @@map("receipts")
}
