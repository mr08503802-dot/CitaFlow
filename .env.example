PORT=3000
DATABASE_URL="file:./dev.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/citaflow_prod?schema=public"

JWT_SECRET="your_production_secure_jwt_secret"
FRONTEND_URL="http://localhost:3000"
APP_NAME="CitaFlow"
NODE_ENV="development"

# ==========================================
# WHATSAPP INTEGRATION CONFIGURATION
# ==========================================
# Options: 'mock' (default), 'cloud_api' (Meta), 'twilio'
WHATSAPP_PROVIDER=mock

# 1. Meta WhatsApp Cloud API (Graph API)
# Setup at: https://developers.facebook.com/apps/
META_WA_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WA_ACCESS_TOKEN=your_meta_system_user_access_token
META_WA_VERIFY_TOKEN=citaflow_meta_verify_token_2026
META_WA_API_VERSION=v21.0

# 2. Twilio Programmable Messaging API (Optional alternative)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886
